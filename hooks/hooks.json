        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/enable-autoupdate.mjs\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
